# Modelo de Variáveis de Ambiente para Deploy e Desenvolvimento Local
# Copie este arquivo para .env no seu ambiente local ou configure estas variáveis no painel da Vercel / Netlify / Cloudflare.

# Neon Auth (autenticação de nutricionistas)
VITE_NEON_AUTH_URL=https://sua-instancia.neonauth.aws.neon.tech/neondb/auth

# Connection string do Neon PostgreSQL (OBRIGATÓRIA para CRUD de pacientes e consultas)
DATABASE_URL=postgresql://neondb_owner:senha@ep-xxxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Google Gemini API Key (para geração de planos alimentares com IA)
# GOOGLE_API_KEY=sua_chave_google_aqui
